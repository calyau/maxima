#!@POSIX_SHELL@
# -*- Shell-script -*-

RLWRAP=rlwrap
type $RLWRAP > /dev/null 2>&1
if [ "$?" -ne "0" ]; then
    echo "$0 error: rmaxima requires rlwrap." >& 1
    echo "rlwrap is available from <https://github.com/hanslub42/rlwrap>." >& 1
    exit 1
fi


if [ "@default_layout_autotools@" = "true" ]; then
  MAXIMA_SHAREDIR="@expanded_datadir@/@PACKAGE@/@VERSION@/share"
else
  MAXIMA_SHAREDIR="@expanded_top_srcdir@/share"
fi

MAXIMA_BUILTINS=$MAXIMA_SHAREDIR/builtins-list.txt

# Run the maxima installed beside this script, not the first one on PATH.
# Follow symlinks to find the real script. In the build tree this script
# is src/rmaxima and runs maxima-local.
script=$0
while [ -h "$script" ]; do
  link=$(readlink "$script") || break
  case $link in
    /*) script=$link ;;
    *) script=$(dirname "$script")/$link ;;
  esac
done
bindir=$(dirname "$script")
if [ -x "$bindir/../maxima-local" ]; then
  MAXIMA=$bindir/../maxima-local
elif [ -x "$bindir/maxima" ]; then
  MAXIMA=$bindir/maxima
else
  MAXIMA=maxima
fi

if [ -f "$MAXIMA_BUILTINS" ]; then
  exec rlwrap --always-readline --complete-filenames --break-chars '(){}[].,*/+-=&^$#@\;|´`:' --file "$MAXIMA_BUILTINS" --remember --command-name maxima "$MAXIMA" --disable-readline "$@"
else
  echo "$0: failed to locate list of built-in symbols; go ahead without it."
  echo "$0: (I thought it might be $MAXIMA_BUILTINS but there is no such file.)"
  exec rlwrap --always-readline --complete-filenames --break-chars '(){}[].,*/+-=&^$#@\;|´`:' --remember --command-name maxima "$MAXIMA" --disable-readline "$@"
fi
