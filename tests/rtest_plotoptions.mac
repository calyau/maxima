/* mailing list 2016-01-08: "set_plot_option question" */

(set_plot_option([style,[points,3],[lines,2]]),get_plot_option(style));
[style, [points, 3], [lines, 2]]$

/*
 * Bug #3186, get_plot_option cannot get the last pair of *plot-options*
 *
 * Also, make sure get_plot_option returns a copy of *plot-options* so
 * changes to the result of get_plot_option don't change
 * *plot-options* unexpecgedly.
 */
get_plot_option('gnuplot_term);
[gnuplot_term, default];

c:get_plot_option('color);
[color, blue, red, green, magenta, black, cyan];

c[2]:'purple;
purple;

get_plot_option('color);
[color, blue, red, green, magenta, black, cyan];

/* mailing list 2026-04-02: Recent changes to "box" has broken plot options */

(set_plot_option (['box, true]), get_plot_option ('box));
[box, true];

(set_plot_option (['box, false]), get_plot_option ('box));
[box, false];

(set_plot_option (['point_type, 'box]), get_plot_option ('point_type));
[point_type, box];

[house, box]: [3, 4];
[3, 4];

house;
3;

box;
4;

remvalue (box);
[box];

box;
box;




/* Plot filenames must leave the caller's Common Lisp RNG unchanged. */
(kill(all),0);
0$

(load(file_search("plot-random-state-check.lisp",file_search_tests)),0);
0$

plot_rng_preservation_check();
true$

plot_rng_error_check();
true$

plot_rng_generated_check();
true$

plot_rng_parallel_check(true);
true$

plot_rng_parallel_check(false);
true$

plot_rng_path_check();
true$

(kill(all),0);
0$

plot_rng_maxima_check();
true$

plot_rng_fresh_check();
true$


/* Temporary-file registration and cleanup under concurrent plotting. */
(kill(all),0);
0$

(load(file_search("parallel-input-check.lisp",file_search_tests)),
 load(file_search("temp-file-registry-check.lisp",file_search_tests)),0);
0$

temp_registry_paths_check();
true$

temp_registry_duplicate_check();
true$

temp_registry_empty_check();
true$

temp_registry_cleanup_check(false);
true$

temp_registry_cleanup_check(true);
true$

temp_registry_parallel_check(true);
true$

temp_registry_parallel_check(false);
true$

temp_registry_print_check(false,false);
true$

temp_registry_print_check(true,false);
true$

temp_registry_print_check(false,true);
true$

temp_registry_print_check(true,true);
true$

(kill(all),0);
0$
