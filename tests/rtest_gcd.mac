/* Bug #5780: "gcd() with algebraic : true hangs for polynomials with several parameters" */

block([D : expand((x^2+c^2)*(d*x^2-1)*(e*x^4+d*x^2+1)),
       N : expand((x^2+c^2)*(l1*(x^5+c*d*x^3+%i*e)+l2*(d*x^4-%i*c^2*x+1)+l3*(e*x^5+x^2-d)+l4*(c*x^3+e*d*x-%i*c)))],
  makelist(block([algebraic : true, gcd : g], gcd(N, D)), g, ['algebraic, 'subres, 'red]));
[x^2+c^2, x^2+c^2, x^2+c^2]$

/* Variables in only one polynomial do not occur in the gcd, unless algebraic numbers tie them to the other one: */
[gcd(expand((3*x+sqrt(d))*(d+3-l*sqrt(d))), expand((3*x+sqrt(d))*(sqrt(d)-2*d*x))),
 gcd(expand((x-sqrt(1+sqrt(c)))*((sqrt(1+sqrt(c))+1)*l+1)), expand((x-sqrt(1+sqrt(c)))*(x+1))),
 gcd(x^2-c, x-sqrt(c)), gcd(expand((x^4-2*x^2+1-c)*(l*x+1)), x-sqrt(1+sqrt(c))),
 gcd(x-%i, x^2+1), gcd(x^2+1, expand((x-%i)*(l*x+1)))], algebraic : true;
[3*x+sqrt(d), x-sqrt(sqrt(c)+1), x-sqrt(c), x-sqrt(sqrt(c)+1), x-%i, x-%i]$

/* Here sqrt(c) ties the main variable c to the coefficients: */
block([G : 3*sqrt(c)*x^2+2*sqrt(c)+2*c^2, P, Q, g, algebraic : true],
  P : expand(G*(2*c*d^2-c^2*l*x)),
  Q : expand(G*(c*x^2-c*sqrt(c)*x)),
  g : gcd(P, Q, sqrt(c), l, x, d, c),
  [remainder(P, g, x), remainder(Q, g, x)]);
[0, 0]$

/* PQUOTIENT ignores sqrt(1-x^2)^2 = 1-x^2, so the gcd of the coefficients in l gives up. The PRS finds the factor: */
block([a : sqrt(1-x^2)],
  makelist(block([algebraic : true, gcd : g],
                 gcd((-l*a*x^6+(3*l+1)*a*x^4-3*l*a*x^2+(l-1)*a)*ii^3+(-3*l*x^7+(9*l+3)*x^5+(-9*l-3)*x^3+3*l*x)*ii^2
                     +(3*l*a*x^6+(-6*l-3)*a*x^4+(3*l+3)*a*x^2-a)*ii+l*x^7+(-2*l-1)*x^5+(l+2)*x^3-x,
                     (x^6-3*x^4+3*x^2-1)*ii^3+(-3*a*x^5+6*a*x^3-3*a*x)*ii^2+(-3*x^6+6*x^4-3*x^2)*ii+a*x^5-a*x^3,
                     l, a, x, ii)),
           g, ['algebraic, 'subres, 'red]));
[ii*(x^2-1)-x*sqrt(1-x^2), ii*(x^2-1)-x*sqrt(1-x^2), ii*(x^2-1)-x*sqrt(1-x^2)]$

/* ALGNORMAL fails on this gcd, which is then returned as it is: */
block([a : sqrt(1+sqrt(c)), P, Q, g, algebraic : true],
  P : expand((1-a*x)*((a+1)*l+1)),
  Q : expand((1-a*x)*(x+1)),
  g : gcd(P, Q),
  [freeof(l, g), hipow(g, x), remainder(P, g, x), remainder(Q, g, x)]);
[true, 1, 0, 0]$


/* Bug #5787: "gcd() with algebraic : true can return a non-divisor or miss a common factor" */

block([t : (%i+1)*x+3*%i, algebraic : true],
  [gcd(2*c*x-1, expand(t*(2*c*x-1)), x, c), gcd(expand(t*(2*c*x-1)), expand(t*(c*x+2)), x, c),
   gcd(expand(t*(2*c*x-1)*(c+x)), expand(t*(2*c*x-1)*(c-x)), x, c)]);
[2*c*x-1, 2*x+3*%i+3, c*(4*x^2+(6*%i+6)*x)-2*x-3*%i-3]$

block([P : expand(((3-2*%i)*x-2*%i*c)*(e*x+(1+%i)*e-1)), Q : expand(((3-2*%i)*x-2*%i*c)*(3*x^2+%i*e*x+2*e+3*c)),
       algebraic : true],
  [gcd(P, Q), block([gcd : 'subres], gcd(P, Q)), block([gcd : 'subres], ratsimp(P/Q))]);
[13*x+(4-6*%i)*c, 13*x+(4-6*%i)*c,
 ((2*%i-3)*e*x+(-%i-5)*e-2*%i+3)/((6*%i-9)*x^2+(-3*%i-2)*e*x+(4*%i-6)*e+(6*%i-9)*c)]$

/* The denominator that OLDCONTENT drops here contains c: */
block([a : sqrt(1+sqrt(c)), G, algebraic : true],
  G : (e-a)*x^2+(c-a)*x+2*a*e+2*c,
  block([gcd : 'subres], gcd(expand(G*(a*m+(1+a*e+2*a)*x)), expand(G*(e-c-2*a*e*x)))));
(e-sqrt(sqrt(c)+1))*x^2+(c-sqrt(sqrt(c)+1))*x+2*sqrt(sqrt(c)+1)*e+2*c$
