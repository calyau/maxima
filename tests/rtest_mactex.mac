(texput (degrees_F, "^o\\;{\\rm F}", postfix), 0);
0;

(texput ("foopostfix", "\\;\\mathit{foo}", postfix), 0);
0;

tex ('("After texput" : [degrees_F(85), x foopostfix, degrees_F (x foopostfix)]), false);
