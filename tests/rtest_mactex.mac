";

(texput ("<<", [" \\langle ", " \\rangle "], matchfix), 0);
0;

tex ('("After texput" : <<x, y>>), false);
"$$\\mbox{ After texput }: \\langle x , y \\rangle $$
";

tex ('("Before texput" : foonofix), false);
"$$\\mbox{ Before texput }:{\\it foonofix}\\left(\\right)$$
";

(texput ("foonofix", "\\;\\mathsf{foo}\\;", nofix), 0);
0;

tex ('("After texput" : foonofix), false);
