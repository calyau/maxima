0;

tex (foo, false);
"
\\begin{verbatim}
foo():=(tex('integrate(x^n,x,0,inf)),tex('sum(x^n,n,1,inf)),tex('limit(x^n,x,inf)),tex('diff(x^n,x)));
\\end{verbatim}

";

(foo (), 0);
0;

tex ("Capture standard output as a string.", false);
"$$\\mbox{ Capture standard output as a string. }$$
";

/* tex(expr, filename) and tex(expr, stream) are branches of $TEX that
   tex(expr, false) does not reach.  Write into maxima_tempdir and
   delete both files at the end of this file, so a suite run leaves
   nothing behind. */
(tmpfile_c : sconcat (maxima_tempdir, "/rtest-mactex-c.tex"),
 tmpfile_d : sconcat (maxima_tempdir, "/rtest-mactex-d.tex"), 0);
0;

(tex ("Write output directly to a named file.", tmpfile_c), 0);
0;

(s : openw (tmpfile_d), 0);
0;

(tex ("Write output to an open output stream.", s), 0);
0;

(close (s), 0);
0;

/* The three settings below are global and survive kill(all): a leaked
   one changes tex() output in every later file of the test suite.  Save
   what they were; the end of this file puts them back. */
(saved_tex_env_default : get_tex_environment_default (),
 saved_tex_env_mdefine : get_tex_environment (":="), 0);
0;

(set_tex_environment_default (" \\begin{equation} ", " \\end{equation} "), 0);
0;

(set_tex_environment ("=", "$", "$"), 0);
0;

(set_tex_environment (":=", "$$", "$$"), 0);
0;

