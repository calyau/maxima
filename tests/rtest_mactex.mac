";

tex ('("All together now" : <<fooprefix foo foonary foo foonary foonofix foopostfix>>), false);
"$$\\mbox{ All together now }: \\langle \\mathrm{foo}\\;\\phi\\upsilon \\;\\mathbf{foo}\\;\\phi\\upsilon \\;\\mathbf{foo}\\;\\;\\mathsf{foo}\\;\\;\\mathit{foo} \\rangle $$
";

tex ('diff (y(x), x, 3) + 'diff (y(x), x, 2) + 'diff (y(x), x) + y(x) + a = 0, false);
