/* Tests of the TeX output of tex().
 *
 * These are the expressions from tests/rtest_tex.mac, which is a LaTeX
 * document generator meant to be read by a human.  It is in neither
 * $testsuite_files nor $share_testsuite_files, so none of its output was
 * ever checked automatically.  Here each expression is paired with the
 * string tex() returns, so that a change is noticed.
 *
 * Every expected string was checked to be well-formed LaTeX -- balanced
 * braces, balanced \\left and \\right, $$ delimiters -- before being
 * recorded.  That check found a real defect: texput of a TeX control word
 * ran it into the following letter, giving TeX that does not compile.
 * Without fixing that first, this file would have pinned it in place.
 *
 * The setup statements between the tests are not decoration.  They
 * declare operators, install texput and index properties, toggle
 * stringdisp, and kill names that later expressions reuse, so keep them
 * in this order.
 *
 * Expressions that read the input or output history are left out -- %%,
 * _ and the two calling labels() -- because their value depends on their
 * own position in the file.
 */

(kill (all), 0);
0;

(linel:2^10, 0);
0;

((prefix ("fooprefix"), infix ("implies"), infix ("iff"), nary ("foonary"), postfix ("foopostfix"), matchfix ("<<", ">>"), nofix ("foonofix")), 0);
0;

(infix ("-->"), 0);
0;

(texput ("-->", "\\rightarrow", infix), 0);
0;

('((aa or bb) and not (cc or dd)), 0);
0;

