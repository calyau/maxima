/* Leave the environment as we found it.  "=" had no environment of its
   own before, and there is no way to take one away again; giving it the
   default back is equivalent, since get-tex-environment falls through to
   the default exactly when the property is absent. */
(set_tex_environment_default (saved_tex_env_default[1],
                              saved_tex_env_default[2]),
 set_tex_environment ("=", saved_tex_env_default[1],
                           saved_tex_env_default[2]),
 set_tex_environment (":=", saved_tex_env_mdefine[1],
                            saved_tex_env_mdefine[2]), 0);
0;

[get_tex_environment_default (), get_tex_environment ("=")];
[["$$", "$$"], ["$$", "$$"]];

(?delete\-file (tmpfile_c), ?delete\-file (tmpfile_d), 0);
0;

(kill (all), 0);
0;
