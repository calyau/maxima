/* A runner's precision changes are local, including on exceptional exit. */
map(lambda([m], parallel_precision_restored(m,false)), [fallback,caller,public]);
[true,true,true]$

map(lambda([m], parallel_precision_restored(m,true)), [fallback,caller,public]);
[true,true,true]$

if parallel_threads_available() then
 [parallel_precision_restored(worker,false),parallel_precision_restored(worker,true)]
else [true,true];
[true,true]$

map(parallel_precision_internal,[serial,fallback,caller,public]);
[true,true,true,true]$

if parallel_threads_available() then parallel_precision_internal(worker) else true;
