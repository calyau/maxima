/* Parallel bodies must refuse input before printing or consuming it.
 * Serial questions and answers established without input still work. */

(kill(all), 0);
0$

(load(file_search("parallel-input-check.lisp", file_search_tests)), 0);
0$

parallel_input_serial_check();
true$

parallel_input_check(fallback);
true$

parallel_input_check(caller);
true$

if parallel_threads_available() then parallel_input_check(worker) else true;
true$

parallel_input_check(public);
true$

parallel_input_random_check();
true$

/* All user entry points, nested regions and a single item. */
errcatch(parallel_makelist(readonly(), i, 1, 1));
[]$

errcatch(parallel_makelist(read(), i, 1, 8));
[]$

errcatch(parallel(for i: 1 thru 8 do readonly()));
[]$

errcatch(for i: 1 thru_parallel 8 do read());
[]$

errcatch(for i in_parallel [1, 2, 3] do readonly());
[]$

errcatch(do_parallel(read(), readonly()));
[]$

errcatch(parallel_makelist(parallel_makelist(read(), j, 1, 3), i, 1, 3));
[]$

/* Empty bodies must not be evaluated. */
parallel_makelist(read(), i, []);
[]$

/* Unknown facts produce errors, never invented mathematical answers. */
errcatch(parallel_makelist(asksign(a), i, 1, 1));
[]$

errcatch(parallel_makelist(askinteger(a), i, 1, 1));
[]$

errcatch(parallel_makelist(askinteger(a, even), i, 1, 1));
[]$

errcatch(parallel_makelist(integrate(exp(-a*x), x, 0, inf), i, 1, 1));
[]$

[facts(), is(a > 0), featurep(a, integer)];
[[], unknown, false]$

/* Questions are still possible outside a parallel body after errors. */
parallel_input_serial_check();
true$

limit((exp(a*x)-1)/(exp(a*x)+1), x, inf), ask_hide_prompt; p;
1$

/* Known facts need no interaction and must retain their exact answers. */
parallel_makelist(asksign(i), i, [-2, 0, 3]);
[neg, zero, pos]$

parallel_makelist(askinteger(i), i, [2, 1/2, -3]);
[yes, no, yes]$

parallel_makelist(askinteger(i, even), i, [2, 3, 1/2]);
[yes, no, no]$

(assume(a > 0), 0);
0$

parallel_makelist(asksign(a), i, 1, 8);
[pos, pos, pos, pos, pos, pos, pos, pos]$

/* Keep the integration checks serial here: concurrent integration has
 * existing shared-state failures tracked separately in issue #3. */
parallel_makelist(integrate(exp(-a*x), x, 0, inf), i, 1, 1);
[1/a]$

(forget(a > 0), facts());
[]$

block([parallel_threads:1],
      parallel_makelist(integrate(x^i, x, 0, 1), i, 0, 5));
[1, 1/2, 1/3, 1/4, 1/5, 1/6]$

/* Refusal must also hold when the caller has explicitly chosen one core. */
block([parallel_threads:1], errcatch(do_parallel(read(), readonly())));
[]$

(kill(all), 0);
0$
