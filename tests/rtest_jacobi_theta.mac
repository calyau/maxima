/* The bigfloat nearest %pi/2, a zero of theta2 */
closeto_relerr(jacobi_theta(2, bfloat(%pi/2), 0.3b0),
               -1.62602612897134024592508020892433126b-33,
               2^-106);
true$

(fpprec:oldfpprec, kill(oldfpprec, closeto_relerr), done);
done$
