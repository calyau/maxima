 featurep(%pi, constant));
true;

(forget(kind(%i, imaginary)),
 featurep(%i, imaginary));
true;

(remove(acosh, complex),
 featurep(acosh, complex));
true;

(forget(zeroa > 0),
 sign(zeroa));
pos;

(forget(zerob < 0),
 sign(zerob));
neg;

length(facts(global)) - num_facts;
0;

errcatch(context : global);
[];

killcontext(global);
not_done;

is(context = ctx);
true;

(killcontext(ctx),
 kill(k, ctx, num_facts),
 0);
0;


/* Bugs #4919 and #4920: forget() and remove() report what they did */

(kill(k1, k2, ctx),
 supcontext(ctx),
 0);
0;

forget(k1 > 0);
[redundant];

forget(kind(k1, complex));
[redundant];

(assume(k1 > 0),
 forget(k1 > 0));
[k1 > 0];

forget(k1 > 0);
[redundant];

(assume(kind(k1, complex)),
 forget(kind(k1, complex)));
[kind(k1, complex)];

forget(kind(k1, complex));
[redundant];

/* Datums, not knowledge: k1 > 0 was derivable but never stored. */
(assume(k1 > 1),
 forget(k1 > 0));
[redundant];

is(k1 > 0);
true;

(forget(k1 > 1), 0);
0;

/* One answer per argument, in order. */
(assume(k1 > 0),
 forget(k1 > 0, k1 < 5));
[k1 > 0, redundant];

/* Built-in facts are declined, and say so. */
forget(kind(%pi, constant));
[not_done];

forget(zeroa > 0);
[not_done];

remove(%pi, constant);
not_done;

featurep(%pi, constant);
true;

/* remove() reports a refusal, not an absence. */
(declare(k2, integer),
 remove(k2, integer));
done;

remove(k2, integer);
done;

(kill(k1, k2, ctx), 0);
0;

(kill(ctx), 0);
0;

(newcontext(ctx),
 killcontext(global, ctx));
not_done;

member(ctx, contexts);
false;

killcontext(ctx);
not_done;

context;
initial;


/* Bug #3676: "asksign(x*cos(y) - x) --> incorrect result, without assume(x > 0)" */

[asksign(x*cos(y) - x), sign(x)], ask_hide_prompt; p;
[pos, pnz];

[asksign(x*(cos(y) - 1)), sign(x)], ask_hide_prompt; n;
[neg, pnz];

[asksign(x*sin(y) - x), sign(x)], ask_hide_prompt; p;
[pos, pnz];


/* Bug #3677: "asksign(x*cos(y) - x) --> "Is 1 zero or nonzero?" with assume(x > 0)" */

block([r], assume(x > 0), r: asksign(x*cos(y) - x), forget(x > 0), r), ask_hide_prompt; neg;
neg;

block([r], assume(x > 0), r: asksign(x*cos(y) - x), forget(x > 0), r), ask_hide_prompt; zero;
zero;

block([r], assume(x2 > 0), r: asksign(4*x2^2*cos(y)^2 - 4*x2^2), forget(x2 > 0), r), ask_hide_prompt; neg;
neg;


/* Bug #3999: "asksign(cos^2 - 1)" */

asksign(cos(phi) - 1), ask_hide_prompt; n;
neg;

asksign(cos(phi)^2 - 1), ask_hide_prompt; n;
neg;

[asksign((cos(x) - 1)*phi^3), sign(phi)], ask_hide_prompt; n;
[neg, pnz];

block([r],
 assume(4*cos(phi)^2 - 4 < 0, sin(phi) > 0),
 r: integrate(1/(1 - cos(phi)^2*sin(x)^2), x, 0, %pi/2),
 forget(4*cos(phi)^2 - 4 < 0, sin(phi) > 0),
 r);
%pi/(2*sin(phi));


/* Bug #2213: "sign of an array" */

errcatch(sign(array(aaa, 3))), use_fast_arrays: true;
[];

(kill(aaa), sign(array(aaa, 3)));
pnz;

(kill(aaa), 0);
0;


/* Bug #5175: "asksign(log(x)) records the wrong fact" */

[asksign(log(a)), sign(log(a)), facts()], ask_hide_prompt; pos;
[pos, pos, [log(a) > 0]];

[asksign(log(a)), sign(log(a)), facts()], ask_hide_prompt; neg;
[neg, neg, [0 > log(a)]];

[asksign(log(a)), sign(log(a)), facts()], ask_hide_prompt; zero;
[zero, zero, [equal(log(a), 0)]];

block([a], local(a), assume(a > 0), [asksign(log(a)), sign(a - 1), is(a > 1), facts()]), ask_hide_prompt; pos;
[pos, pos, true, [a > 0, a > 1]];

block([a], local(a), assume(a > 0), [asksign(log(a)), sign(a - 1), facts()]), ask_hide_prompt; neg;
[neg, neg, [a > 0, 1 > a]];

block([a], local(a), assume(a > 0), [asksign(log(a)), sign(a - 1), facts()]), ask_hide_prompt; zero;
[zero, zero, [a > 0, equal(a, 1)]];


/* Bug #5172: "assume(a>1,b>0)$ is(a*b>1) -> true" */

block([a, b], local(a, b), assume(a > 1, b > 0), is(a * b > 1));
unknown;

block([a, b], local(a, b), assume(a > 1, b > 1), is(a * b > 1));
true;


/* Bug #5093: "After assume(notequal(x,0)), is(log(x) > 0) returns false and sign(log(x)) signals an imaginary argument error" */

block([x], local(x), assume(notequal(x, 0)), sign(log(x)));
pnz;


/* Bug #5120: "forget(notequal(a*b,0)) deletes an assumed notequal(a,0) that the database never entailed" */

block([a, b],
 local(a, b),
 assume(notequal(a, 0)),
 [forget(notequal(a * b, 0)), is(notequal(a, 0))]);
[[redundant], true];

block([a, b],
 local(a, b),
 assume(notequal(a * b, 0)),
 [forget(notequal(a * b, 0)), is(notequal(a * b, 0))]);
[[notequal(a * b, 0)], unknown];


/* Bug #5115: "csign(%i*j) returns neg for j declared imaginary, so abs(%i*j) can evaluate to a negative number" */

block([j],
 local(j),
 declare(j, imaginary),
 [csign(%i*j), abs(%i*j)]);
[pnz, abs(j)];

block([x, y],
 local(x, y),
 assume(x < 0, y < 0),
 csign(sqrt(x) * y^(3/2)));
pnz;


/* Bug #5176: "forget() over-removes facts" */
/* Bug #5177: "Some sub-facts are not normalized and cannot be removed via forget()" */
/* Bug #5188: "assume(notequal(x^3, y^3)) -> is(notequal(x^3, y^3)) = unknown" */

block([x],
 local(x),
 assume(x < 1),
 [is(x < 1), forget(abs(x) < 1), is(x < 1)]);
[true, [redundant], true];

block([x],
 local(x),
 assume(x > -1),
 [is(x > -1), forget(abs(x) < 1), is(x > -1)]);
[true, [redundant], true];

block([x],
 local(x),
 assume(abs(x) < 1),
 [is(abs(x) < 1), forget(abs(x) < 1), is(x < 1), is(x > -1), killcontext(learndata)]);
[true, [abs(x) < 1], unknown, unknown, done];

block([p, q],
 local(p, q),
 assume(notequal(p, q)),
 [is(notequal(p, q)), forget(notequal(p^2, q^2)), is(notequal(p, q))]);
[true, [redundant], true];

block([p, q],
 local(p, q),
 assume(notequal(p^2, q^2)),
 [is(notequal(p^2, q^2)), forget(notequal(p^2, q^2)), is(notequal(p, q)), is(notequal(p, -q))]);
[true, [notequal(p^2, q^2)], unknown, unknown];

block([p, q],
 local(p, q),
 assume(notequal(p^3, q^3)),
 [is(notequal(p^3, q^3)), forget(notequal(p^3, q^3)), is(notequal(p, q))]);
[true, [notequal(p^3, q^3)], unknown];


/* Leave this at the end of the file! */
[facts(), contexts];
[[], [initial, global]];
