/* bug reported to mailing list 2021-06-27: "ev(xxx,pred) vs is(xxx)" */

xxx:  '((0 < 1) or (0 < 2));
(0 < 1) or (0 < 2);

ev(xxx, pred);
true;

ev(xxx, nouns);
true;

is(xxx);
true;

yyy: '((0 < 1) and (0 < 2));
(0 < 1) and (0 < 2);

is(yyy);
true;

zzz: '((0 > 1) or (0 < 2));
(0 > 1) or (0 < 2);

is(zzz);
true;

aaa: '((0 > 1) and (0 < 2));
(0 > 1) and (0 < 2);

is(aaa);
false;

bbb: '((0 > 1) or (0 > 2));
(0 > 1) or (0 > 2);

is(bbb);
false;

(kill(xyz), ccc: '((xyz > 4) or (3 > 2)));
(xyz > 4) or (3 > 2);

is(ccc);
true;

ddd: '((2 < 1) or (2 < 2) or (1 < 3) and (2 < 4));
(2 < 1) or (2 < 2) or ((1 < 3) and (2 < 4));

is(ddd);
true;

