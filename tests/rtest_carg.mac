/*******************************************************************************
 *
 *          carg function
 *
 * The examples show what a Maxima user can expect from the carg function.
 * Examples are taken from functions.wolfram.com.
 *
 ******************************************************************************/

/* ---------- Initialization ------------------------------------------------ */

kill(all);
done;

declare([z,z1,z2],complex, n,integer);
done;

/* ---------- Specific values ----------------------------------------------- */

assume(x>0);
[x>0];

carg(x);
0;
carg(-x);
%pi;
carg(%i*x);
%pi/2;
carg(-%i*x);
-%pi/2;

forget(x>0);
[x>0];

carg(x+%i*y);
atan2(y,x);

/* ---------- Values at fixed points ---------------------------------------- */

carg(1);
0;

carg(-1);
%pi;

carg(%i);
%pi/2;

carg(-%i);
-%pi/2;

carg(1+%i);
%pi/4;

carg(-1+%i);
3*%pi/4;

carg(-1-%i);
-3*%pi/4;

carg(1-%i);
-%pi/4;

carg(sqrt(3)+%i);
%pi/6;

carg(1+%i*sqrt(3));
%pi/3;

carg(-1+%i*sqrt(3));
2*%pi/3;

carg(-sqrt(3)+%i);
5*%pi/6;

carg(-sqrt(3)-%i);
-5*%pi/6;

carg(-1-%i*sqrt(3));
-2*%pi/3;

carg(1-%i*sqrt(3));
-%pi/3;

carg(sqrt(3)-%i);
-%pi/6;

carg(2);
0;

carg(-2);
%pi;

carg(%pi);
0;

carg(3*%i);
%pi/2;

carg(-2*%i);
-%pi/2;

carg(2+%i);
atan(1/2);

/* --- Values at infinities ------------------------------------------------- */

carg([inf,-inf,minf,-minf,%i*inf,%i*minf,infinity]);
[0,%pi,%pi,0,%pi/2,-%pi/2,ind];

/* ---------- Parity -------------------------------------------------------- */

/* Add examples for Parity */

/* ---------- Mirror symmetry ----------------------------------------------- */

/* Add examples for Mirror symmetry */

/* ---------- Homogeneity --------------------------------------------------- */

assume(a>0);
[a>0];

carg(a*z);
carg(z);

carg(a*(x+%i*y));
atan2(y,x);

forget(a>0);
[a>0];

/* ---------- Transformations ----------------------------------------------- */

/* ----- Argument involving complex characteristics ------------------------- */

carg(abs(z));
0;

carg(z/abs(z));
carg(z);
carg(x/abs(x));
atan2(0,x);

/* Maxima does not simplify the following examples */

carg(signum(z));
carg(z);
carg(signum(x));
atan2(0,x);


/* ----- Argument involving basic arithmetic operations --------------------- */

/* Add more examples for sums, products and quotients */

/* ----- Power of arguments -------------------------------------------------- */

carg(sqrt(z));
carg(z)/2;
carg(sqrt(x+%i*y));
1/2*atan2(y,x);

assume(x>0);
[x>0];
carg(x^z);
atan2(sin(log(x)*'imagpart(z)),cos(log(x)*'imagpart(z)));
forget(x>0);
[x>0];

carg(z^a);
atan2(sin(a*'carg(z)),cos(a*'carg(z)));

carg(z1^z2);
atan2(sin('carg(z1)*'realpart(z2)+log(abs(z1))*'imagpart(z2)),
      cos('carg(z1)*'realpart(z2)+log(abs(z1))*'imagpart(z2)));

/* ----- Exponent of arguments ---------------------------------------------- */

carg(exp(x+%i*y));
atan2(sin(y),cos(y));

/* ---------- Complex characteristics --------------------------------------- */

realpart(carg(x+%i*y));
atan2(y,x);

imagpart(carg(x+%i*y));
0;

abs(carg(x+%i*y));
sqrt(atan2(y,x)^2);

carg(carg(x+%i*y));
atan2(0,atan2(y,x));

conjugate(carg(x+%i*y));
atan2(y,x);

signum(carg(x+%i*y));
signum(atan2(y,x));


/* Bug #5606: "cabs(erf(%i)^2) crashes Maxima with control stack exhausted" */

block([nv : lambda([e], float(expand(rectform(float(e)))))],
  [is(abs(nv(cabs(erf(%i)^2)) - erfi(1.0)^2) < 1e-12),
   is(abs(nv(cabs(gamma(%i)^3)) - cabs(float(gamma(%i)))^3) < 1e-12),
   is(abs(nv(carg(gamma(%i)^3)) - nv(carg(rectform(float(gamma(%i))^3)))) < 1e-12),
   is(abs(nv(polarform(gamma(%i)^2)) - nv(float(gamma(%i))^2)) < 1e-12),
   rectform(atan2(-%i*erf(%i), 0))]);
[true, true, true, true, atan2(-%i*erf(%i), 0)]$


/* Bug #5078: "carg() of tan() or tanh() of a complex number is off by %pi when the real part of the result is negative" */

[carg(tan(x + %i*y)), carg(tanh(x + %i*y)), carg(cot(x + %i*y)), carg(coth(x + %i*y))];
[atan2(sinh(2*y), sin(2*x)), atan2(sin(2*y), sinh(2*x)), atan2(-sinh(2*y), sin(2*x)), atan2(-sin(2*y), sinh(2*x))]$

map(lambda([f, u],
      block([w : apply(f, [u]), v],
        v : rectform(float(w)),
        [is(abs(float(carg(w)) - carg(v)) < 1e-14),
         is(cabs(float(rectform(polarform(w))) - v) < 1e-14),
         is(cabs(float(rectform(log(w))) - log(v)) < 1e-14)])),
    [tan, cot, tanh, coth],
    [2 + 3*%i, 2 + 3*%i, -2 + 3*%i, -2 + 3*%i]);
[[true, true, true], [true, true, true], [true, true, true], [true, true, true]]$

[cabs(tan(log(%i))), carg(tan(log(%i))), cabs(tanh(%i*log(%i))), carg(tanh(%i*log(%i))), cabs(coth(y*log(%i)))];
[sqrt(cosh(%pi) - 1)/sqrt(cosh(%pi) + 1), %pi/2, sqrt(cosh(%pi) - 1)/sqrt(cosh(%pi) + 1), %pi, sqrt(cos(%pi*y) + 1)/sqrt(1 - cos(%pi*y))]$


/* Bug #5217: "rectform(sqrt(x*y)) under domain : complex" */

[subst([x = -1, y = -1], rectform(sqrt(x*y))),
 block([domain : complex],
  [subst([x = -1, y = -1], rectform(sqrt(x*y))),
   subst([x = -1, y = -1, z = -1], rectform(sqrt(x*y*z)))])];
[1, [1, %i]]$

[carg(-x), carg(-2*x), carg(-x*y), carg(%i*x), carg((1+%i)*x)];
[%pi - atan2(0, x), %pi - atan2(0, x), %pi - atan2(0, x*y), %pi/2 - atan2(0, x),
 %pi/4 - atan2(0, x)]$

subst([x = -1, y = -1], [carg(-x), carg(-x*y), carg(%i*x), carg((1+%i)*x)]);
[0, %pi, -%pi/2, -3*%pi/4]$

subst(x = -8, [rectform(sqrt(-x)), polarform(sqrt(-x)), rectform(log(-x)),
               block([domain : complex], rectform((-x)^(1/3)))]);
[2^(3/2), 2^(3/2), log(8), 2]$

/* Products with complex factors (z, z1 and z2 are declared complex at the
   top): reduced only when the sum can leave (-%pi, %pi]. */
[carg(%i*sqrt(z)), carg(sqrt(z1)*sqrt(z2)), carg(-%i*sqrt(x + %i*y))];
[carg(z)/2 + %pi/2, carg(z1)/2 + carg(z2)/2, atan2(y, x)/2 - %pi/2]$

subst([z1 = -1 + %i, z2 = -1 + %i],
      [carg(z1*z2), rectform(sqrt(z1*z2)), carg(-z1), polarform(-z1)]);
[-%pi/2, 1 - %i, -%pi/4, sqrt(2)*%e^(-%i*%pi/4)]$

/* ---------- End of file rtest_carg.mac ------------------------------------ */
