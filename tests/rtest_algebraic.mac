((2^(2/3) * 5^(2/3) - 5 * 5^(1/3) - 2 * 2^(1/3))/29)$

(eq : 4*z^2-2*z-1,0);
0$

(sol : solve(eq,z),0);
0$

map(lambda([s], ratsimp(subst(s,eq))), sol);
