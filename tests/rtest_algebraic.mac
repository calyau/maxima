/* Bug #2863: "divide with fractional powers and algebraic:true -- never returns" */

divide(1,x^(2/3)+1), algebraic;
[(x^(4/3)-x^(2/3)+1)/(x^2+1),0];

divide(x^2+1,x^(2/3)+1), algebraic;
[x^(4/3)-x^(2/3)+1,0];


/* Bug #3130: ""quotient by zero" when ratsimping this innocent expression" */

block([p,r],
 p: partfrac(x/((x-4^(1/3))*(x^2+2^(2/3)*x+2^(4/3))),x),
 r: ratsimp(p),
 [radcan(r), ratsimp(r-x/(x^3-4))]);
[x/(x^3-4),0];


/* Bug #5655: "linsolve returns wrong solutions for some systems with %i or radicals" */

block([eqs, sol],
 eqs : [x + c*y + %i*z = 1 + %i, c*x + sqrt(2)*y + z = 2, -x + y + sqrt(c)*z = %i],
 sol : linsolve(eqs, [x, y, z]),
 ratsimp(subst(sol, map(lambda([e], lhs(e) - rhs(e)), eqs))));
[0, 0, 0]$


/* Bug #5657: "linsolve returns a wrong solution for a system with c and sqrt(c)" */

block([eqs, sol],
  eqs : [c*y + z = %i, sqrt(c)*y + c*z = c, sqrt(c)*x + y + c*z = c],
  sol : linsolve(eqs, [x, y, z]),
  ratsimp(subst(sol, map(lhs, eqs) - map(rhs, eqs))));
[0, 0, 0]$

/* Bug #5707: "ratsimp treats sqrt(x) and x^(1/4) as unrelated" */

block([algebraic : false],
  [ratsimp((7^(1/4)+1)*(7^(1/4)-1)*sqrt(7)),
    ratsimp(sqrt(x)*(x^(1/4)*y+1) - x^(3/4)*y),
    ratsimp((7^(1/4)+1)^2*(sqrt(7)+1) - (sqrt(7)+1)*(sqrt(7)+2*7^(1/4)+1))]);
[7-sqrt(7), sqrt(x), 0]$

block([algebraic : false],
  ratsimp((7^(1/4)*(7^(3/4)*%i*a*c + 3*sqrt(2)*sqrt(7)*%i*a*c
      - 4*sqrt(7)*%i*a*c + 7^(1/4)*%i*a*c - 4*%i*a*c + 7^(5/4)*a*c
      + 7^(3/4)*a*c - 4*sqrt(7)*a*c - 3*sqrt(2)*a*c - 4*a*c + 8*7^(3/4)*b
      - 8*sqrt(7)*b + 8*7^(1/4)*b - 8*b))/48
    + (7^(3/4)*%i*a*c + 3*sqrt(2)*sqrt(7)*%i*a*c - 4*sqrt(7)*%i*a*c
      + 7^(1/4)*%i*a*c - 4*%i*a*c + 7^(5/4)*a*c + 7^(3/4)*a*c
      - 4*sqrt(7)*a*c - 3*sqrt(2)*a*c - 4*a*c + 8*7^(3/4)*b - 8*sqrt(7)*b
      + 8*7^(1/4)*b - 8*b)/48
    + ((sqrt(2)*%i - %i - 1)*(sqrt(2)*sqrt(7)*%i - 2*7^(1/4)*%i
      + sqrt(2)*%i - 2*7^(3/4) + sqrt(2)*sqrt(7) - sqrt(2))*a*c)/32));
b$

block([algebraic : false],
  [ratsimp((x^(1/6)+x^(1/4))/(sqrt(x)-x^(1/3))),
    block([domain : complex], ratsimp((x^(1/6)+x^(1/4))/(sqrt(x)-x^(1/3))))]);
[(x^(1/4)+x^(1/6))/(sqrt(x)-x^(1/3)), 1/(x^(1/4)-x^(1/6))]$

block([algebraic : false, radexpand : false, e],
  e : ((-2)^(1/3)-1)/((-2)^(1/6)-1),
  [is(ratsimp(e) = e), block([domain : complex], is(ratsimp(e) = (-2)^(1/6) + 1))]);
[true, true]$
