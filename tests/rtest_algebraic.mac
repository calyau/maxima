(kill(all), algebraic : true, 0);
0$

ratsimp([2 / sqrt(2), -2/sqrt(2), 1 / (1 + sqrt(2)), -1/(1 + sqrt(2)), 1/(sqrt(2) - 1), -1/(sqrt(2) -1)]);
[sqrt(2),  -sqrt(2), sqrt(2) - 1, 1 - sqrt(2), sqrt(2) + 1,  -1 - sqrt(2)]$

