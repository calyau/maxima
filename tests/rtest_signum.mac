[signum(1/x), -1];

block([e : signum(sqrt(x))], [e, subst(x = -4, e)]);
[signum(sqrt(x)), %i];

signum(x^%i);
signum(x^%i);

signum(x^(2 + %i));
signum(x^(2 + %i));

assume(notequal(x, 0));
[notequal(x, 0)];

signum(x)^2;
