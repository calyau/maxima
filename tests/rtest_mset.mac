/* Public scheduler, serial fallback. */
block([parallel_threads:1], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],n+1),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

/* Public scheduler, serial fallback. */
block([parallel_threads:1], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],n+1+0*sum(j,j,1,3)),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

/* Public scheduler, serial fallback. */
block([parallel_threads:1], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],block([local_value],local_value:n+1,local_value)),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

/* Public scheduler, native worker budget. */
block([parallel_threads:4], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],n+1),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

/* Public scheduler, native worker budget. */
block([parallel_threads:4], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],n+1+0*sum(j,j,1,3)),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

/* Public scheduler, native worker budget. */
block([parallel_threads:4], every(identity,makelist(is(equal(parallel_makelist(apply(lambda([n],block([local_value],local_value:n+1,local_value)),[i]),i,-32,32),makelist(i+1,i,-32,32))),trial,1,10)));
true$

(kill(all),0);
