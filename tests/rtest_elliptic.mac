             -7.62467854352286456198305764923936017b-1 + 3.02324185363929479211313523082241917b-1*%i,
             -6.91325022821222063674474488732064470b-1 + 1.57129015423914619697483681220484576b-1*%i,
             -9.65794333174415071357345450678257393b-1 + 1.26800493159222275355516292611889998b-1*%i,
             -9.83336472112777656992190024923096366b-1 - 1.77608133015453039714665379644542393b-1*%i,
             -4.58553715646803605307335052496046927b-1 - 7.85457625331070626791189048860725482b-2*%i,
             -1.76317410880759372631708702431579915b-1 + 4.99006579516169313026664590060526183b-1*%i,
              1.59732274948654412318481916287919482b0  + 2.48966529521992193162783920166078882b0*%i,
              8.28024493078028417849365960338059298b-1 - 8.73821661974562686608211314376421172b-1*%i]],
  makelist(block([z : 2*k*%i, m : 1.75b0+%i],
      [closeto(jacobi_sn(z, m) - ref[k + 1], 5b-20),
       closeto(sin(jacobi_am(z, m)) - ref[k + 1], 5b-20)]),
    k, 0, 10));
[[true, true], [true, true], [true, true], [true, true], [true, true],
 [true, true], [true, true], [true, true], [true, true], [true, true],
 [true, true]];

/*
 * #4352 elliptic_e signals an error due to elliptic_ec returning a
 * Maxima complex instead of Lisp complex.
 */
closeto(elliptic_e(1,1.23) - 0.7935821331230606, 1e-15); 
true;

closeto(elliptic_e(1,2.0) - (0.09311292177217778*%i+0.5990701173677968), 1e-15);
true;

closeto(elliptic_e(1,1.23b0)- 7.9358213312306066216147457280131b-1, 1b-32);
true;

closeto(elliptic_e(1,2b0) - (9.3112921772178507209815461615041b-2*%i+5.9907011736779610371996124614016b-1), 2b-32);
true;


/* Bug #3745: "Quoting either elliptic_f  inhibits simplification" */

'elliptic_f(phi, 0);
phi;

'elliptic_e(phi, 0);
phi;

closeto('elliptic_f(1.0, 0.5) - 1.0832167728451687, 1e-15);
true;

closeto('elliptic_e(1.0, 0.5) - 0.9273298836244401, 1e-15);
true;

/* Bug 5663 */
closeto(jacobi_sn(20.0, 2.5) - 0.2282498061811287, 4.7740e-15);
true;

closeto(jacobi_sn(20.0*%i, 0.75) - (-0.2325715776527406*%i), 3.8858e-15);
true;

closeto(jacobi_sn(20.0*%i, 1.75 + %i) - (0.8280244930780284-0.8738216619745627*%i), 8.0428e-15);
true;

closeto(jacobi_dn(20.0*%i, 0.75) - 1.020081934968419, 6.6614e-16);
true;

block([z : 20.0*%i],
  [closeto(jacobi_dn(z, 0.75) - 1.020081934968419, 6.6614e-16),
   closeto(jacobi_cn(z, 0.75) - 1.026688627935405, 1.33323e-15),
   closeto(jacobi_dn(z, 1.75+%i) - (1.0765867842487509 + 1.2123267066947074*%i), 1.0663e-14),
   closeto(jacobi_cn(z, 1.75+%i) - (-1.2004970668366945 - 0.6027051283045847*%i), 7.1504e-15)]);
[true, true, true, true]$

block([u : 20.0, m : 2.5],
  [closeto(jacobi_sn(u, m) - 0.2282498061811287, 4.7740e-15),
   closeto(jacobi_cn(u, m) - 0.973602601669838, 1.1103e-15),
   closeto(jacobi_dn(u, m) + 0.9326065970953095, 3.2197e-15),
   imagpart(jacobi_dn(u, m))]);
[true, true, true, 0]$

block([u : 20.0, m : 0.99999999],
  [closeto(jacobi_sn(u, m) - 0.8315901214124292, 5.5512e-16),
   closeto(jacobi_cn(u, m) + 0.5553898360334489, 7.7716e-16),
   closeto(jacobi_dn(u, m) - 0.5553898422591851, 1.1103e-15)]);
[true, true, true]$

block([fpprec : 32, m],
  m : 1 - 2b0^-60,
  [closeto(jacobi_cn(20b0, m) - 4069705528989350766860108776551655/10^42, 4.8214e-40),
   closeto(jacobi_dn(20b0, m) - 4174908960764880545715816189280978/10^42, 4.5918e-40)]);
[true, true]$

/* m = 1-2^-53, the largest float below 1.  sqrt(mu) must be computed
 * from sqrt(1-m) alone, or cn and dn lose about 4 more digits.
 */
block([u : 20.0, m : 1 - 2.0^-53],
  [closeto(jacobi_cn(u, m) + 2.6107123887567846e-9, 4.7977e-23),
   closeto(jacobi_dn(u, m) - 1.0855326878511021e-8, 1.3235e-23)]);
[true, true]$

/* Large negative m.  Without A&S 16.10, 1+sqrt(mu) cancels and about
 * log10(sqrt(-m)) digits are lost.  The condition number with respect
 * to u is about 2e5 here, so the tolerances are relatively large.
 */
block([u : 3.0, m : -1e10],
  [closeto(jacobi_sn(u, m) - 0.11593314977968198, 2.5943e-12),
   closeto(jacobi_cn(u, m) + 0.99325701849126736, 3.0287e-13),
   closeto(jacobi_dn(u, m) - 11593.315021096501, 2.5943e-7)]);
[true, true, true]$

/* Bug #4300: "jacobi_sn(99.0, 1.5) incorrect" */

block([u : 99.0, m : 1.5],
  [closeto(jacobi_sn(u, m) + 0.37384023685931953, 2.1650e-15),
   closeto(jacobi_cn(u, m) - 0.9274931144245589, 9.9921e-16),
   closeto(jacobi_dn(u, m) - 0.8890248680197038, 1.3323e-15),
   imagpart(jacobi_dn(u, m))]);
[true, true, true, 0]$

/* m = -6: K' = K(7) is complex, so c = %pi*K/K' is complex, and c - t*w
 * crosses the cut of gd on the imaginary axis (Re(c - w) = -0.012).
 * The atan form of the n = 1 term would give a value 2*%pi too small,
 * -0.512517991630382 - 0.730409062546729*%i.  sin(am) and cos(am) are
 * the same for both values, so compare am directly.
 */
closeto(jacobi_am(0.5772232141353463 - 0.8530005393245824*%i, -6.0)
          - (5.770667315549204 - 0.7304090625467289*%i),
        2.6669e-15);
true;

block([fpprec : 34],
  closeto(jacobi_am(0.5772232141353462916862296464673008b0
                      - 0.8530005393245824453542288836251924b0*%i,
                    -6b0)
            - (5.770667315549203976645055969662078b0
               - 0.730409062546728844474551912372623685b0*%i),
          5.7819b-33));
true;

/*
 * small real z (atan form needed)
 * Maxima returns 1e-10, so error is 0.
 */
closeto(jacobi_am(1e-10, 0.5) - (1e-10), 1e-26);
true;

/*
 * small complex z
 * Maxima returns 1e-10+1e-10*%i, so the error is 0.
 */
closeto(jacobi_am(1e-10 + 1e-10*%i, 0.5) - (1e-10 + 1e-10*%i), 2.4635e-16);
true;

/* pure imaginary z inside the strip (x = 0 in gd) */
closeto(jacobi_am(0.5*%i, 0.5) - (0.5110340303683639*%i), 2.2205e-16);
true;

/* just right of the cut on Re z = 0, Im z = 2K' */
closeto(jacobi_am(0.01 + 3.7081493546027438*%i, 0.5) - (3.1315927369212515 + 8.441410233306306e-17*%i), 1.0522e-16);
true;

/* just left of the cut on Re z = 0, Im z = 2K' */
closeto(jacobi_am(-0.01 + 3.7081493546027438*%i, 0.5) - (-3.1315927369212515 + 8.441410233306306e-17*%i), 1.0522e-16);
true;

/* just right of the cut on Re z = 2K, Im z = 2K' */
closeto(jacobi_am(3.7181493546027435 + 3.7081493546027438*%i, 0.5) - (6.2731853905110455 + 8.441410233306306e-17*%i), 1.7774e-15);
true;

/* just left of the cut on Re z = 2K, Im z = 2K' */
closeto(jacobi_am(3.698149354602744 + 3.7081493546027438*%i, 0.5) - (0.0099999166685415 + 8.441410233306306e-17*%i), 5.3939e-16);
true;

/* outside the strip, atan form would take the wrong branch */
closeto(jacobi_am(5.0 + 4.63518669325343*%i, 0.5) - (5.0316986110742326 - 0.665780525838114*%i), 9.9302e-16);
true;

/*
 * outside the strip, atan form would take the wrong branch
 * Maxima returns the expected value exactly.  Error is 0.
 */
closeto(jacobi_am(9.0 + 2.7811120159520577*%i, 0.5) - (8.001946388979002 + 0.6198094465206705*%i), 7.7716e-16);
true;

/* large real part, many terms */
closeto(jacobi_am(40.0 + 0.3*%i, 0.5) - (33.79229751498364 + 0.2626466062643533*%i), 7.1133e-15);
true;

/* conjugate of a point above */
closeto(jacobi_am(3.0 - 0.5*%i, 0.5) - (2.427244174112757 - 0.4494598711253508*%i), 2.2205e-16);
true;

/* m > 1, real u, four cut crossings */
closeto(jacobi_am(16.0, 2.5) - (24.878832226728502), 4.3382e-15);
true;

/* m > 1, real u just before the first cut crossing */
closeto(jacobi_am(2.2384039195933316, 2.5) - (0.009999583346874235), 7.9733e-16);
true;

/* m > 1, real u just after the first cut crossing */
closeto(jacobi_am(2.258403919593331, 2.5) - (6.273185723832713), 8.8941e-16);
true;

/* m > 1, complex u */
closeto(jacobi_am(1.0 + 2.0*%i, 2.5) - (2.332625972754849 + 0.0716954393741584*%i), 9.3919e-16);
true;

/* m < 0, real u */
closeto(jacobi_am(3.0, -6.0) - (5.370636654846048), 2.6660e-15);
true;

/* complex m (regression value only) */
closeto(jacobi_am(1.0 + 0.5*%i, 0.5 + 0.5*%i) - (1.0522120502921914 + 0.3720246084963857*%i), 4.7429e-16);
true;

/* complex m (regression value only) */
closeto(jacobi_am(2.0 - 1.0*%i, 3.0 - 2.0*%i) - (3.1789721511707696 + 0.7585556617487619*%i), 1.6166e-15);
true;

/* Large real argument.  sinh and cosh of A + w overflow in double
 * precision unless z is first reduced by a multiple of 2*K.
 */
closeto(jacobi_am(1000.0, 0.5) - 847.1374038213264, 1.1369e-13);
true;

block([fpprec : 34],
  closeto(jacobi_am(1000b0, 0.5b0)
          - 847.1374038213263652582547303663649586b0,
          6.4095b-31));
true;

/* Small m: 1-m rounds to 1, so K(1-m) cannot be computed.  Uses the
 * nome series with q = m/16.
 */
closeto(jacobi_am(0.5, 1e-20) - 0.5, 1e-30);
true;

/* Small m: nome series instead of the slowly converging Sala series. */
closeto(jacobi_am(10.0, 1e-3) - 9.997613139826175, 1e-30);
true;

closeto(jacobi_am(3.0, 1e-10) - 2.9999999999215072, 1e-30);
true;

/* The true value 0.49999999999999998... rounds to 0.5; the result is
 * 1 ulp high.
 */
closeto(jacobi_am(0.5, 1e-15) - 0.5, 1.1103e-16);
true;

/* Bigfloat versions with fpprec = 32 */
closeto(jacobi_am(3b0, 1b-30) - 2.999999999999999999999999999999215073063b0,
        1.2326b-32);
true;

closeto(jacobi_am(10b0, 1b-3) - 9.997613139826175470212430692094748670371b0,
        1b-50);
true;

/* 1-1b-40 rounds to 1 at fpprec = 32 */
closeto(jacobi_am(3b0, 1b-40) - 3b0, 2.4652b-32);
true;

(fpprec:oldfpprec,kill(l2,l3,test_deriv,oldfpprec),done);
done;

