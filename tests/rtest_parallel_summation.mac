/* Per-invocation scratch state in sum simplification. */
(kill(all),0);
0$

(load(file_search("parallel-input-check.lisp",file_search_tests)),
 load(file_search("parallel-summation-check.lisp",file_search_tests)),0);
0$

summation_serial_check();
true$

summation_reentry_check('serial);
true$

summation_reentry_check('worker);
true$

summation_reentry_check('throw);
true$

summation_random_check();
true$

summation_parallel_check(true);
true$

summation_parallel_check(false);
true$

/* Existing polynomial, binomial, geometric and unevaluated sums. */
block([simpsum:true],sum(k^4,k,1,20));
722666$

block([simpsum:true],sum(binomial(12,k),k,0,12));
4096$

block([simpsum:true],sum(2^k,k,0,10));
2047$

block([simpsum:true],sum(1/3^k,k,1,inf));
1/2$

block([simpsum:true],sum(k^2+f(k),k,1,3));
f(1)+f(2)+f(3)+14$

block([simpsum:true,errormsg:false],errcatch(sum(2^k,k,1,inf)));
[]$

summation_match_state_check();
true$

(kill(all),0);
0$
